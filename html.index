<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BusinessCalc</title>

    <link rel="stylesheet" href="style.css">

</head>

<body>

<header>

    <h1>📊 BusinessCalc</h1>

    <p>Calculadora para Matemática de Negócios</p>

</header>

<div class="container">

    <aside class="menu">

        <button onclick="mostrar('porcentagem')">
            📈 Porcentagem
        </button>

        <button onclick="alert('Em desenvolvimento')">
            💰 Lucro
        </button>

        <button onclick="alert('Em desenvolvimento')">
            📊 Margem
        </button>

        <button onclick="alert('Em desenvolvimento')">
            📦 Estoque
        </button>

        <button onclick="alert('Em desenvolvimento')">
            🛒 Vendas
        </button>

    </aside>

    <main>

        <section id="porcentagem" class="card">

            <h2>Calculadora de Porcentagem</h2>

            <label>Valor</label>

            <input
                type="number"
                id="valor"
                placeholder="Digite um valor">

            <label>Porcentagem (%)</label>

            <input
                type="number"
                id="porcentagemValor"
                placeholder="Ex.: 15">

            <button onclick="calcularPorcentagem()">

                Calcular

            </button>

            <button onclick="limpar()">

                Limpar

            </button>

            <div id="resultado">

                Resultado aparecerá aqui.

            </div>

        </section>

    </main>

</div>

<script src="script.js"></script>

</body>

</html>
